# --- Embedding Model ---
# Options: local (sentence-transformers), openai (openai compatible api)
EMBEDDING_PROVIDER=...
# Embedding model name (required)
EMBEDDING_MODEL_NAME=...
# Embedding Base URL if openai (optional)
EMBEDDING_BASE_URL=...
# API KEY (optional)
EMBEDDING_API_KEY=...

# --- RAG DB ---
# Path for DB relative to root
DB_PATH=...

# --- LLM Model ---
# LLM model name (required)
LLM_MODEL=...
# Base URL for the LLM, openai compatible only (optional)
LLM_BASE_URL=...
# LLM api key (optional)
LLM_API_KEY=...
