# --- Embedding Model ---
# Options: local (sentence-transformers), openai (openai compatible api)
EMBEDDING_PROVIDER=...
# Embedding Base URL if openai
EMBEDDING_BASE_URL=...
# Embedding model name
EMBEDDING_MODEL_NAME=...
# API KEY
EMBEDDING_API_KEY=...

# --- RAG DB ---
# Path for DB relative to root
DB_PATH=...

# --- LLM Model ---
# Base URL for the LLM, openai compatible only
LLM_BASE_URL=...
# LLM model name
LLM_MODEL=...
# LLM api key
LLM_API_KEY=...
